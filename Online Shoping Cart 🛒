        }

        for (j = 0; categoryLower[j]; j++)
        {
            categoryLower[j] =
                (char)tolower((unsigned char)categoryLower[j]);
        }

        if (strstr(nameLower, keyword) != NULL ||
            strstr(categoryLower, keyword) != NULL)
        {
            printProduct(&products[i]);

            found = 1;
        }
